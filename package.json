{
	"name": "kinesynth",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm gen:meta && vite dev",
		"build": "pnpm gen:meta && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test tests/shots.e2e.ts tests/viewer.e2e.ts",
		"test": "pnpm run check && pnpm run check:cores && pnpm run check:meta && pnpm run check:determinism && pnpm run test:e2e",
		"shots": "playwright test tests/shots.e2e.ts",
		"smoke": "LIVE_URL=${LIVE_URL:-https://kinesynth.vercel.app} playwright test tests/live.e2e.ts",
		"gen:meta": "node scripts/gen-meta.mjs",
		"check:meta": "node scripts/gen-meta.mjs --check",
		"check:cores": "node scripts/check-cores.mjs",
		"gen:determinism": "node scripts/determinism.mjs",
		"check:determinism": "node scripts/determinism.mjs --check"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vercel": "^59.3.0",
		"vite": "^8.0.16"
	}
}
